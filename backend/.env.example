# === Base de données ===
# PostgreSQL avec l'extension pgvector.
DATABASE_URL=postgresql://user:password@localhost:5432/nexia_db

# === Sécurité ===
# Clé secrète pour signer les tokens JWT. Générez-en une aléatoire, par ex. :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez_moi

# Durée de validité du token (en minutes). Défaut : 7 jours.
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === CORS ===
# Origines autorisées à appeler l'API, séparées par des virgules.
# En local : le serveur Vite. En production : l'URL exacte du frontend Vercel
# (sans barre oblique finale), sinon le navigateur bloquera les requêtes.
CORS_ORIGINS=http://localhost:5173

# === Choix du fournisseur de LLM ===
# Valeurs possibles : ollama | gemini | groq | openai
LLM_PROVIDER=ollama

# --- Ollama (local, gratuit, données confidentielles) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Google Gemini (hébergé, tier gratuit) ---
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Groq (hébergé, tier gratuit) ---
# Clé : https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Fournisseur générique compatible OpenAI (LLM_PROVIDER=openai) ---
# Presque tous les services hébergés exposent la même API : changer de
# fournisseur ne demande que ces trois variables, jamais de modification du
# code. Décommentez le bloc de votre choix.
#
# Mistral — société européenne, données en Europe (https://console.mistral.ai)
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-small-latest
#
# Cerebras — inférence très rapide (https://cloud.cerebras.ai)
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
# OPENAI_MODEL=llama-3.3-70b
#
# Hugging Face — même compte que le Space (https://huggingface.co/settings/tokens)
# OPENAI_BASE_URL=https://router.huggingface.co/v1
# OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct
#
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
